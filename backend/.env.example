# ==============================================================================
# VISION2WEB - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Credentials (Optional for local development; if omitted, repository layer uses seed catalog)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Storage Configuration
STORAGE_BUCKET_PRODUCTS=product-catalog-images
STORAGE_BUCKET_QUERIES=visual-search-queries
LOCAL_STORAGE_PATH=./uploads

# Visual Search Settings
VISUAL_SEARCH_PROVIDER=prototype
MIN_SIMILARITY_THRESHOLD=0.35
MAX_UPLOAD_SIZE_BYTES=5242880
